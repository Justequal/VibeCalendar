{
  "name": "vibe-calendar",
  "version": "1.0.0",
  "description": "A beautiful, modern open-source desktop calendar",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/calendar-core.test.js",
    "check:syntax": "node --check src/main/main.js && node --check src/main/updater.js && node --check src/renderer/calendar-core.js && node --check src/renderer/holidays.js && node --check src/renderer/renderer.js",
    "verify": "npm run check:syntax && npm test",
    "pack": "electron-builder --dir",
    "build": "electron-builder"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.vibecalendar.app",
    "productName": "Vibe Calendar",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "YourUsername",
        "repo": "VibeCalendar"
      }
    ]
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}

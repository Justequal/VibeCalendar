{
  "name": "vibe-calendar",
  "version": "1.0.2",
  "description": "A beautiful, modern open-source desktop calendar",
  "author": "Vibe Calendar Contributors",
  "license": "MIT",
  "homepage": "https://github.com/Justequal/VibeCalendar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Justequal/VibeCalendar.git"
  },
  "bugs": {
    "url": "https://github.com/Justequal/VibeCalendar/issues"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "preview:web": "explorer src\\renderer\\index.html",
    "test": "node --test",
    "check:syntax": "node --check src/main/main.js && node --check src/main/updater.js && node --check src/renderer/calendar-core.js && node --check src/renderer/holidays.js && node --check src/renderer/renderer.js",
    "verify": "npm run check:syntax && npm test",
    "pack": "electron-builder --dir",
    "build": "electron-builder"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.vibecalendar.app",
    "productName": "Vibe Calendar",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "artifactName": "Vibe-Calendar-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "src/assets/icon.ico",
      "uninstallerIcon": "src/assets/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}

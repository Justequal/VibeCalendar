{
  "name": "helloworld-calendar",
  "version": "1.0.0",
  "description": "A beautiful desktop calendar hello world project",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.helloworld.calendar",
    "productName": "Vibe Calendar",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.8.1",
    "electron-winstaller": "^5.4.0",
    "innosetup-compiler": "^6.3.1"
  }
}
